<?xml version="1.0"?>
<ruleset name="animewp security">
	<description>WordPress security and PHP compatibility checks for the theme and plugin (not coding style).</description>

	<file>themes/animewp</file>
	<file>plugins/animewp-blocks</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<!-- Generated by @wordpress/scripts: dependency lists only. -->
	<exclude-pattern>plugins/animewp-blocks/build/*\.asset\.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<!-- Output escaping, nonces, input validation and sanitization, safe redirects. -->
	<rule ref="WordPress.Security"/>
	<!-- SQL must be prepared. -->
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<!-- Dangerous or obfuscation-prone PHP. -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
	<rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
	<rule ref="WordPress.PHP.DevelopmentFunctions"/>
	<rule ref="Squiz.PHP.Eval"/>
	<rule ref="Generic.PHP.BacktickOperator"/>
	<!-- Supported runtimes. -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.0-"/>
	<config name="minimum_wp_version" value="6.6"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="animewp"/>
				<element value="animewp-blocks"/>
			</property>
		</properties>
	</rule>
</ruleset>
