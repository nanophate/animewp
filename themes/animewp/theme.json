{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    },
    "color": {
      "custom": true,
      "customGradient": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "base",
          "name": "基本背景",
          "color": "var(--wp--preset--color--animewp-base,#ffffff)"
        },
        {
          "slug": "surface",
          "name": "淡い背景",
          "color": "var(--wp--preset--color--animewp-surface,#f3f3f3)"
        },
        {
          "slug": "contrast",
          "name": "基本文字・濃い面",
          "color": "var(--wp--preset--color--animewp-ink,#202020)"
        },
        {
          "slug": "muted",
          "name": "補助文字",
          "color": "var(--wp--preset--color--animewp-muted,#595959)"
        },
        {
          "slug": "accent",
          "name": "強調",
          "color": "var(--wp--preset--color--animewp-accent,#262626)"
        },
        {
          "slug": "border",
          "name": "罫線",
          "color": "var(--wp--preset--color--animewp-line,#d5d5d5)"
        },
        {
          "slug": "on-accent",
          "name": "強調面の文字",
          "color": "#ffffff"
        },
        {
          "slug": "on-contrast",
          "name": "濃い面の文字",
          "color": "#ffffff"
        },
        {
          "slug": "badge-info",
          "name": "情報ラベル背景",
          "color": "#414141"
        },
        {
          "slug": "badge-info-text",
          "name": "情報ラベル文字",
          "color": "#ffffff"
        },
        {
          "slug": "badge-media",
          "name": "メディアラベル背景",
          "color": "#555555"
        },
        {
          "slug": "badge-media-text",
          "name": "メディアラベル文字",
          "color": "#ffffff"
        },
        {
          "slug": "badge-event",
          "name": "イベントラベル背景",
          "color": "#333333"
        },
        {
          "slug": "badge-event-text",
          "name": "イベントラベル文字",
          "color": "#ffffff"
        },
        {
          "slug": "badge-music",
          "name": "音楽ラベル背景",
          "color": "#666666"
        },
        {
          "slug": "badge-music-text",
          "name": "音楽ラベル文字",
          "color": "#ffffff"
        },
        {
          "slug": "animewp-base",
          "name": "基本背景（従来互換）",
          "color": "#ffffff"
        },
        {
          "slug": "animewp-surface",
          "name": "淡い背景（従来互換）",
          "color": "#f3f3f3"
        },
        {
          "slug": "animewp-ink",
          "name": "基本文字・濃い面（従来互換）",
          "color": "#202020"
        },
        {
          "slug": "animewp-muted",
          "name": "補助文字（従来互換）",
          "color": "#595959"
        },
        {
          "slug": "animewp-accent",
          "name": "強調（従来互換）",
          "color": "#262626"
        },
        {
          "slug": "animewp-line",
          "name": "罫線（従来互換）",
          "color": "#d5d5d5"
        }
      ],
      "gradients": [
        {
          "slug": "animewp-wash",
          "name": "淡い色面",
          "gradient": "linear-gradient(135deg,var(--wp--preset--color--surface),var(--wp--preset--color--base))"
        }
      ],
      "duotone": [
        {
          "slug": "animewp-ink-paper",
          "name": "墨と紙",
          "colors": [
            "#202020",
            "#ffffff"
          ]
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "小",
          "size": "12px"
        },
        {
          "slug": "30",
          "name": "標準",
          "size": "24px"
        },
        {
          "slug": "40",
          "name": "中",
          "size": "40px"
        },
        {
          "slug": "50",
          "name": "大",
          "size": "64px"
        },
        {
          "slug": "60",
          "name": "余白",
          "size": "96px"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "lineHeight": true,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "animewp-sans",
          "name": "端末標準ゴシック",
          "fontFamily": "system-ui, -apple-system, \"Hiragino Kaku Gothic ProN\", \"Yu Gothic\", sans-serif"
        },
        {
          "slug": "animewp-serif",
          "name": "端末標準明朝",
          "fontFamily": "\"Yu Mincho\", \"Hiragino Mincho ProN\", Georgia, serif"
        },
        {
          "slug": "animewp-role-display",
          "name": "用途：英字・大見出し",
          "fontFamily": "var(--animewp-role-display, var(--wp--custom--animewp--font-display, Georgia, serif))"
        },
        {
          "slug": "animewp-role-accent-hand",
          "name": "用途：短いアクセント文",
          "fontFamily": "var(--animewp-role-accent-hand, var(--wp--custom--animewp--font-accent-hand, \"Yu Mincho\", \"Hiragino Mincho ProN\", serif))"
        },
        {
          "slug": "animewp-role-mono",
          "name": "用途：日付・等幅文字",
          "fontFamily": "var(--animewp-role-mono, var(--wp--custom--animewp--font-mono, ui-monospace, SFMono-Regular, Consolas, monospace))"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "小",
          "size": "0.8125rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "本文",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "見出し",
          "size": "1.75rem",
          "fluid": {
            "min": "1.4rem",
            "max": "1.75rem"
          }
        },
        {
          "slug": "x-large",
          "name": "大見出し",
          "size": "2.6rem",
          "fluid": {
            "min": "1.8rem",
            "max": "2.6rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "作品名",
          "size": "4.5rem",
          "fluid": {
            "min": "2.4rem",
            "max": "4.5rem"
          }
        }
      ],
      "defaultFontSizes": false
    },
    "custom": {
      "animewp": {
        "radius": {
          "small": "4px",
          "medium": "18px",
          "pill": "999px"
        },
        "sectionSpace": "clamp(3rem, 7vw, 6rem)",
        "headerHeight": "5rem",
        "fontDisplay": "Georgia, serif",
        "fontAccentHand": "\"Yu Mincho\", \"Hiragino Mincho ProN\", serif",
        "fontMono": "ui-monospace, SFMono-Regular, Consolas, monospace"
      }
    },
    "shadow": {
      "presets": [
        {
          "slug": "animewp-soft",
          "name": "淡い影",
          "shadow": "0 1rem 3rem rgb(0 0 0 / 9%)"
        },
        {
          "slug": "animewp-offset",
          "name": "ずらした影",
          "shadow": "0.4rem 0.4rem 0 var(--wp--preset--color--border)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "clamp(20px,4vw,64px)",
        "right": "clamp(20px,4vw,64px)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|animewp-sans",
      "fontSize": "1rem",
      "lineHeight": "1.9"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "600",
          "lineHeight": "1.4",
          "letterSpacing": "0.01em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|contrast"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "typography": {
            "textDecoration": "none"
          }
        }
      },
      "button": {
        "border": {
          "radius": "4px",
          "width": "1px",
          "color": "var:preset|color|accent"
        },
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|on-accent"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "bottom": "12px",
            "left": "24px",
            "right": "24px"
          }
        },
        "typography": {
          "fontSize": "0.875rem",
          "fontWeight": "500",
          "lineHeight": "1.6"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontSize": "1.125rem",
          "fontWeight": "600",
          "lineHeight": "1.4"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.875rem",
          "lineHeight": "1.6"
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontSize": "0.8125rem"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "0.8125rem"
        }
      },
      "core/paragraph": {
        "spacing": {
          "margin": {
            "top": "1rem",
            "bottom": "1rem"
          }
        }
      },
      "core/image": {
        "border": {
          "radius": "0px"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|border"
        },
        "border": {
          "width": "1px"
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var:preset|color|border",
            "width": "2px"
          }
        },
        "spacing": {
          "padding": {
            "left": "24px"
          }
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "animewp-landing",
      "title": "animewp：作品紹介ページ（ページ内メニュー）",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "animewp-canvas",
      "title": "animewp：自由な全面レイアウト",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "animewp-left",
      "title": "animewp：左固定メニュー",
      "postTypes": [
        "page",
        "post"
      ]
    },
    {
      "name": "animewp-right",
      "title": "animewp：右固定メニュー",
      "postTypes": [
        "page",
        "post"
      ]
    },
    {
      "name": "animewp-overlay",
      "title": "animewp：全面表示メニュー",
      "postTypes": [
        "page",
        "post"
      ]
    },
    {
      "name": "animewp-showcase",
      "title": "animewp：余白の作品紹介（画像フッター）",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "上部ヘッダー",
      "area": "header"
    },
    {
      "name": "header-left",
      "title": "左固定ヘッダー",
      "area": "header"
    },
    {
      "name": "header-right",
      "title": "右固定ヘッダー",
      "area": "header"
    },
    {
      "name": "header-overlay",
      "title": "全面表示メニューのヘッダー",
      "area": "header"
    },
    {
      "name": "header-landing",
      "title": "ページ内メニューのヘッダー",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "フッター",
      "area": "footer"
    },
    {
      "name": "comments",
      "title": "コメント",
      "area": "uncategorized"
    },
    {
      "name": "header-glass",
      "title": "透ける上部ヘッダー",
      "area": "header"
    },
    {
      "name": "footer-visual",
      "title": "画像とサイトマップのフッター",
      "area": "footer"
    }
  ]
}
