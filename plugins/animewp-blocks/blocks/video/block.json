{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "animewp/video",
  "version": "1.3.0",
  "title": "AnimeWP 動画ダイアログ",
  "category": "media",
  "icon": "video-alt3",
  "description": "動画ファイル、YouTube、Vimeoを押して開く。外部動画は同意後に接続し、停止後も元リンクが残ります。",
  "textdomain": "animewp-blocks",
  "attributes": {
    "source": {
      "type": "string",
      "enum": [
        "file",
        "youtube",
        "vimeo"
      ],
      "default": "file"
    },
    "videoUrl": {
      "type": "string",
      "default": ""
    },
    "videoId": {
      "type": "number",
      "default": 0
    },
    "posterUrl": {
      "type": "string",
      "default": ""
    },
    "buttonLabel": {
      "type": "string",
      "default": "動画を開く"
    },
    "closeLabel": {
      "type": "string",
      "default": "閉じる"
    },
    "trackUrl": {
      "type": "string",
      "default": ""
    },
    "crossOriginMode": {
      "type": "string",
      "enum": [
        "same-origin",
        "anonymous"
      ],
      "default": "same-origin"
    },
    "trackLanguage": {
      "type": "string",
      "default": "ja"
    },
    "trackLabel": {
      "type": "string",
      "default": "日本語"
    },
    "description": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true,
      "gradients": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "editorScript": "animewp-blocks-editor",
  "style": "animewp-blocks-style",
  "editorStyle": "animewp-blocks-editor-style",
  "viewScript": "animewp-blocks-video-view"
}
