{"translation-revision-date":"2026-10-06T19:24:45+00:00","generator":"WP-CLI\/2.9.0","source":"build\/blocks\/panel\/index.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ja","plural-forms":"nplurals=1; plural=0;"},"Color source":["\u8272\u306e\u6307\u5b9a\u65b9\u6cd5"],"Custom color (kept as is)":["\u4efb\u610f\u306e\u8272\uff08\u65e2\u5b58\u306e\u8272\u3092\u4fdd\u6301\uff09"],"Follow a site color":["\u30b5\u30a4\u30c8\u306e\u8272\u898b\u672c\u306b\u8ffd\u5f93"],"Follow a color role":["\u8272\u306e\u5f79\u5272\u306b\u8ffd\u5f93"],"Site color":["\u8272\u898b\u672c"],"Choose a color":["\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044"],"Color role":["\u8272\u306e\u5f79\u5272"],"Surface (soft background)":["\u6de1\u3044\u80cc\u666f \/ surface"],"Accent":["\u5f37\u8abf \/ accent"],"Contrast (dark surface)":["\u6fc3\u3044\u9762 \/ contrast"],"Site colors and roles update when the color scheme changes; custom colors stay fixed. A role also picks a matching text color unless the block sets its own. Check readability after changing.":["\u8272\u898b\u672c\u30fb\u5f79\u5272\u306f\u914d\u8272\u5909\u66f4\u306b\u8ffd\u5f93\u3057\u307e\u3059\u3002\u4efb\u610f\u306e\u8272\u306f\u305d\u306e\u307e\u307e\u6b8b\u308a\u307e\u3059\u3002\u5f79\u5272\u306f\u5bfe\u5fdc\u3059\u308b\u6587\u5b57\u8272\u3082\u9078\u3073\u307e\u3059\uff08\u6587\u5b57\u8272\u306e\u500b\u5225\u6307\u5b9a\u304c\u512a\u5148\uff09\u3002\u5909\u66f4\u5f8c\u306f\u8aad\u307f\u3084\u3059\u3055\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"None":["\u306a\u3057"],"Soft":["\u67d4\u3089\u304b\u3044\u5f71"],"Hard":["\u304f\u3063\u304d\u308a\u3057\u305f\u5f71"],"Background, text color, spacing and font size use the standard Styles controls.":["\u80cc\u666f\u30fb\u6587\u5b57\u306e\u8272\u3001\u4f59\u767d\u3001\u6587\u5b57\u30b5\u30a4\u30ba\u306f\u6a19\u6e96\u306e\u30b9\u30bf\u30a4\u30eb\u8a2d\u5b9a\u3067\u8abf\u6574\u3057\u307e\u3059\u3002"],"Add a backdrop layer":["\u88c5\u98fe\u80cc\u666f\u30ec\u30a4\u30e4\u30fc\u3092\u8ffd\u52a0"],"Adds a separate color shape behind the content. The standard background is unchanged.":["\u5185\u5bb9\u306e\u5f8c\u308d\u306b\u5225\u306e\u8272\u9762\u3092\u91cd\u306d\u307e\u3059\u3002\u6a19\u6e96\u80cc\u666f\u306f\u305d\u306e\u307e\u307e\u6b8b\u308a\u307e\u3059\u3002"],"Backdrop color":["\u88c5\u98fe\u80cc\u666f\u30ec\u30a4\u30e4\u30fc\u306e\u8272"],"Backdrop edge":["\u88c5\u98fe\u80cc\u666f\u306e\u5883\u754c"],"Straight":["\u306a\u3057"],"Wave":["\u6ce2\u5f62"],"Diagonal":["\u659c\u3081"],"Backdrop rotation (\u00b0)":["\u88c5\u98fe\u80cc\u666f\u3060\u3051\u306e\u56de\u8ee2\uff08\u5ea6\uff09"],"Rotates only the backdrop. Content stays level.":["\u8272\u9762\u3060\u3051\u3092\u56de\u8ee2\u3057\u307e\u3059\u3002\u672c\u6587\u306e\u89d2\u5ea6\u306f\u5909\u308f\u308a\u307e\u305b\u3093\u3002"],"Backdrop skew (\u00b0)":["\u88c5\u98fe\u80cc\u666f\u3060\u3051\u306e\u50be\u659c\uff08\u5ea6\uff09"],"Slants the backdrop. Separate from rotation.":["\u8272\u9762\u3092\u659c\u3081\u306b\u3086\u304c\u3081\u307e\u3059\u3002\u56de\u8ee2\u3068\u306f\u5225\u306e\u5909\u5f62\u3067\u3059\u3002"],"Backdrop opacity (%)":["\u88c5\u98fe\u80cc\u666f\u306e\u4e0d\u900f\u660e\u5ea6\uff08%\uff09"],"Rotate whole panel (\u00b0)":["\u30d1\u30cd\u30eb\u5168\u4f53\u306e\u56de\u8ee2\uff08\u5ea6\uff09"],"Rotates the backdrop and every block inside together.":["\u80cc\u666f\u3068\u3059\u3079\u3066\u306e\u5185\u5074\u30d6\u30ed\u30c3\u30af\u3092\u4e00\u7dd2\u306b\u56de\u8ee2\u3057\u307e\u3059\u3002"],"To tilt only some text, keep this at 0\u00b0 and put that text in a Rotated Text block inside the panel.":["\u4e00\u90e8\u306e\u6587\u5b57\u3060\u3051\u3092\u50be\u3051\u308b\u306b\u306f\u3001\u5168\u4f53\u306e\u56de\u8ee2\u30920\u5ea6\u306b\u3057\u3066\u3001\u5185\u5074\u306b\u300c\u56de\u8ee2\u30c6\u30ad\u30b9\u30c8\u300d\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002"],"Corner radius (px)":["\u89d2\u4e38\uff08px\uff09"],"Panel shadow":["\u30d1\