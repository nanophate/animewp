{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "animewp/carousel",
  "version": "2.0.1",
  "title": "Carousel",
  "category": "design",
  "icon": "slides",
  "description": "Turns the blocks inside it into slides that swipe or cross-fade: video cards, cover images, character profiles, anything. Buttons, dots, numbers or thumbnails, and auto-advance are optional.",
  "keywords": [
    "slider",
    "slideshow",
    "swipe",
    "gallery",
    "animewp"
  ],
  "textdomain": "animewp-blocks",
  "attributes": {
    "slideWidth": {
      "type": "number",
      "default": 100
    },
    "effect": {
      "type": "string",
      "enum": [
        "slide",
        "fade"
      ],
      "default": "slide"
    },
    "navStyle": {
      "type": "string",
      "enum": [
        "icon",
        "text",
        "line",
        "none"
      ],
      "default": "icon"
    },
    "showDots": {
      "type": "boolean",
      "default": true
    },
    "dotStyle": {
      "type": "string",
      "enum": [
        "dots",
        "numbers",
        "thumbnails"
      ],
      "default": "dots"
    },
    "autoplay": {
      "type": "number",
      "default": 0
    },
    "loop": {
      "type": "boolean",
      "default": true
    },
    "emphasizeActive": {
      "type": "boolean",
      "default": false
    },
    "prevLabel": {
      "type": "string",
      "default": "前へ"
    },
    "nextLabel": {
      "type": "string",
      "default": "次へ"
    },
    "label": {
      "type": "string",
      "default": "スライド"
    },
    "pauseLabel": {
      "type": "string",
      "default": "自動切り替えを一時停止"
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true,
      "gradients": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "typography": {
      "fontSize": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScriptModule": "file:./view.js"
}
