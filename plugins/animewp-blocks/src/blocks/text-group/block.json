{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "animewp/text-group",
  "version": "2.0.0",
  "title": "Rotated Text",
  "category": "design",
  "icon": "editor-textcolor",
  "description": "Rotates only the headings and paragraphs inside it, with a separate angle for mobile.",
  "keywords": [
    "rotate",
    "tilt",
    "text",
    "animewp"
  ],
  "textdomain": "animewp-blocks",
  "attributes": {
    "rotation": {
      "type": "number",
      "default": 0
    },
    "mobileRotation": {
      "type": "number",
      "default": 0
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true,
      "gradients": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "animewp-blocks-style",
  "editorStyle": "animewp-blocks-editor-style"
}
